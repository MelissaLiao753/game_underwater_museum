[sub_resource type="GDScript" id="GDScript_hqtel"]
script/source = "extends Node2D

@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D
@onready var ray_cast_right: RayCast2D = $RayCast_Right
@onready var ray_cast_left: RayCast2D = $RayCast_Left
@onready var ray_cast_up: RayCast2D = $RayCast_Up
@onready var ray_cast_down: RayCast2D = $RayCast_Down
 
enum state {horizontal, vertical}

@export var state_type: state =state.horizontal
@export var SPEED: float = 60.0
var direction: int = 1

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if state_type == state.horizontal:
		horizontal_movement(delta)
	else: 
		vertical_movement(delta)

func horizontal_movement(delta: float) -> void:
	animated_sprite_2d.flip_h = direction < 0
	animated_sprite_2d.flip_v = false
	
	if ray_cast_right.is_colliding():
		direction = -1
	elif ray_cast_left.is_colliding():
		direction = 1
	
	position.x += SPEED * delta * direction

func vertical_movement(delta: float) -> void:
	animated_sprite_2d.flip_v = direction < 0
	animated_sprite_2d.flip_h = false
	
	if ray_cast_down.is_colliding():
		direction = -1
	elif ray_cast_up.is_colliding():
		direction = 1
	
	position.y += SPEED * delta * direction
"

