[sub_resource type="GDScript" id="GDScript_p2gul"]
script/source = "extends RichTextLabel
@onready var credits: RichTextLabel = $\".\"


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	credits.text = \"\"\"
UI: [url=https://kenney.nl/assets/ui-pack] Kenney UI Pack [/url]

Assets: [url=https://limezu.itch.io/] Modern_Interiors_Free_v2.2/Modern tiles_Free[/url]

Main Menu: Bella 
Music: Bella
Tilemap: Bella
HUD: Melissa
Player and Enemy Movement & Interaction: Melissa
Object Placement & Item Collection: Melissa
Pixel Art: Bella & Melissa
		\"\"\"



# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_meta_clicked(meta: Variant) -> void:
	OS.shell_open(str(meta))


func _on_back_pressed() -> void:
	get_tree().change_scene_to_file(\"res://menu_main.tscn\")
"

